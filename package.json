{
  "name": "@webship.co/workspace-ide",
  "version": "1.0.11",
  "description": "The Web IDE for Webship Workspace: the IDE menu on every project row and files page (VS Code in the browser, served by the dashboard, or an editor on your own machine), the Edit-in-the-Web-IDE link inside other menus, and the probe that says when the IDE daemon is down. It carries its AI items, each placed in the workspace folder of its kind: a skill, a command and a prompt.",
  "main": "dist/src/index.js",
  "types": "dist/src/index.d.ts",
  "license": "ISC",
  "engines": {
    "node": ">=24"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/webship/workspace-ide.git"
  },
  "files": [
    "dist/src",
    "ai",
    "features",
    "README.md",
    "docs"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepare": "npm run build",
    "test": "npm run build && node --test dist/tests/*.test.js",
    "lint": "tsc -p tsconfig.json --noEmit"
  },
  "workspacePlugin": {
    "name": "ide",
    "label": "Web IDE",
    "needs": [
      "ai-skills",
      "ai-commands",
      "ai-prompts"
    ],
    "ai": {
      "skills": [
        "ai/skills/ide-open-with"
      ],
      "commands": [
        "ai/commands/ide-links.md"
      ],
      "prompts": [
        "ai/prompts/ide-web-ide-check.md"
      ]
    },
    "features": [
      "features/ide.feature"
    ]
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@webship.co/workspace-plugin-api": "^1.0.2",
    "typescript": "^5.9.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
